{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["es2017", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "outDir": "./lib",
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "skipLibCheck": true,
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "lib",
    "example",
    "**/__tests__/*",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
